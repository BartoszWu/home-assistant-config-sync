#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v ruby >/dev/null || {
  echo "Ruby with its standard YAML library is required." >&2
  exit 1
}

ruby -ryaml - "$root" <<'RUBY'
root = File.expand_path(ARGV.fetch(0))

required = [
  "repository.yaml",
  "README.md",
  "export/config.yaml",
  "export/Dockerfile",
  "export/run.sh",
  "import/config.yaml",
  "import/Dockerfile",
  "import/run.sh",
]

missing = required.reject { |relative| File.file?(File.join(root, relative)) }
abort("Missing required files: #{missing.join(', ')}") unless missing.empty?

def load_yaml(root, relative)
  value = YAML.safe_load(
    File.read(File.join(root, relative), encoding: "UTF-8"),
    permitted_classes: [],
    aliases: false,
  )
  abort("#{relative} must contain a YAML mapping") unless value.is_a?(Hash)
  value
rescue Psych::SyntaxError => error
  abort("Invalid YAML in #{relative}: #{error.message}")
end

repository = load_yaml(root, "repository.yaml")
abort("repository.yaml has an unexpected name") unless repository["name"] == "HA Config Sync"

expected = {
  "export" => ["HA Config Sync — Export", "ha_config_sync_export"],
  "import" => ["HA Config Sync — Import", "ha_config_sync_import"],
}

configs = {}
expected.each do |directory, (name, slug)|
  relative = "#{directory}/config.yaml"
  config = load_yaml(root, relative)
  configs[directory] = config
  %w[name description version slug arch].each do |key|
    abort("#{relative} is missing #{key}") unless config.key?(key)
  end
  unless config["name"] == name && config["slug"] == slug
    abort("#{relative} name or slug does not match the repository contract")
  end
  abort("#{relative} version is not semantic x.y.z") unless config["version"].to_s.match?(/\A\d+\.\d+\.\d+\z/)
  abort("#{relative} arch must be a non-empty list") unless config["arch"].is_a?(Array) && !config["arch"].empty?
  %w[full_access docker_api host_network].each do |key|
    abort("#{relative} must not enable #{key}") if config[key]
  end
  mappings = config["map"] || []
  abort("#{relative} map must be a list") unless mappings.is_a?(Array)
  mappings.each do |mapping|
    next unless mapping.is_a?(Hash)
    type = mapping["type"]
    if type == "all_addon_configs"
      abort("#{relative} grants a forbidden broad mapping")
    end
    if type == "homeassistant_config"
      unless directory == "import"
        abort("#{relative} must not map homeassistant_config")
      end
      if mapping["read_only"] != false
        abort("#{relative} homeassistant_config must be writable for Managed Files")
      end
      unless mapping["path"] == "/homeassistant"
        abort("#{relative} homeassistant_config path must be /homeassistant")
      end
    end
  end
end

export_config = configs.fetch("export")
if export_config["ingress"] || export_config["boot"] != "manual_only"
  abort("Export must remain manual-only and must not expose Ingress")
end

import_config = configs.fetch("import")
unless import_config["ingress"] == true && import_config["homeassistant_api"] == true
  abort("Import requires Ingress and the Home Assistant API")
end

import_maps = Array(import_config["map"])
ha_map = import_maps.find { |mapping| mapping.is_a?(Hash) && mapping["type"] == "homeassistant_config" }
abort("Import must map writable homeassistant_config at /homeassistant for Managed Files") unless ha_map
%w[apparmor.txt managed_files.yaml managed_files.py].each do |name|
  abort("Import is missing #{name}") unless File.file?(File.join(root, "import", name))
end
apparmor = File.read(File.join(root, "import", "apparmor.txt"), encoding: "UTF-8")
# Full deny mode set against broad `file,` (apparmor.d(5)): r/w/m/l/k/x plus
# a separate append deny (`a` conflicts with `w` in one ACCESS list).
full_deny = "rwmlkx"
sensitive_dir_denies = {
  ".storage" => true,
  "custom_components" => true,
  ".cloud" => true,
  "backups" => true,
}
sensitive_dir_denies.each_key do |needle|
  dir_rule = "deny /homeassistant/#{needle}/ #{full_deny},"
  tree_rule = "deny /homeassistant/#{needle}/** #{full_deny},"
  dir_append = "deny /homeassistant/#{needle}/ a,"
  tree_append = "deny /homeassistant/#{needle}/** a,"
  unless apparmor.include?(dir_rule)
    abort("import/apparmor.txt must deny directory listing #{needle}/ with #{full_deny}")
  end
  unless apparmor.include?(tree_rule)
    abort("import/apparmor.txt must deny descendants #{needle}/** with #{full_deny}")
  end
  unless apparmor.include?(dir_append) && apparmor.include?(tree_append)
    abort("import/apparmor.txt must deny append on #{needle}/ and #{needle}/**")
  end
end
%w[secrets.yaml configuration.yaml].each do |name|
  file_rule = "deny /homeassistant/#{name} #{full_deny},"
  append_rule = "deny /homeassistant/#{name} a,"
  abort("import/apparmor.txt must deny #{name} with #{full_deny}") unless apparmor.include?(file_rule)
  abort("import/apparmor.txt must deny append on #{name}") unless apparmor.include?(append_rule)
end
%w[*.db *.db-shm *.db-wal *.sqlite *.sqlite3].each do |pattern|
  file_rule = "deny /homeassistant/**/#{pattern} #{full_deny},"
  append_rule = "deny /homeassistant/**/#{pattern} a,"
  abort("import/apparmor.txt must deny DB pattern #{pattern} with #{full_deny}") unless apparmor.include?(file_rule)
  abort("import/apparmor.txt must deny append on DB pattern #{pattern}") unless apparmor.include?(append_rule)
end
policy = File.read(File.join(root, "import", "managed_files.yaml"), encoding: "UTF-8")
abort("managed_files.yaml must not be empty") if policy.strip.empty?
RUBY

python3 - "$root" <<'PY'
import ast
import json
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
if (root / "export/security.py").read_bytes() != (root / "import/security.py").read_bytes():
    raise SystemExit("Security build-context mirrors differ")

for path in root.rglob("*.json"):
    if ".git" not in path.parts:
        with path.open("r", encoding="utf-8") as handle:
            json.load(handle)

for path in root.rglob("*.py"):
    if ".git" not in path.parts:
        ast.parse(path.read_text(encoding="utf-8"), filename=str(path))

for script in (root / "scripts").iterdir():
    if script.is_file() and not script.stat().st_mode & 0o111:
        raise SystemExit(f"{script.relative_to(root)} is not executable")

blocked_names = {
    "github_ed25519", "known_hosts_443", "id_rsa", "id_ed25519",
    "secrets.yaml", ".env",
}
blocked_suffixes = {".key", ".pem", ".p12", ".pfx"}
for path in root.rglob("*"):
    if ".git" in path.parts or not path.is_file():
        continue
    relative_parts = path.relative_to(root).parts
    if "addon_config" in relative_parts or "addon_configs" in relative_parts:
        raise SystemExit(f"App data must not be stored in the repository: {path.relative_to(root)}")
    if path.name in blocked_names or path.suffix.lower() in blocked_suffixes:
        raise SystemExit(f"Credential-like file found: {path.relative_to(root)}")

patterns = {
    "private key": re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    "GitHub token": re.compile(r"\b(?:github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,})\b"),
    "OpenAI token": re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b"),
    "AWS access key": re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    "Bearer token": re.compile(r"\bBearer\s+[A-Za-z0-9._-]{24,}\b"),
    "assigned secret": re.compile(
        r"(?i)\b(?:password|passwd|api[_-]?key|access[_-]?token|client[_-]?secret)\b"
        r"\s*[:=]\s*[\"'][^\"'${}]{12,}[\"']"
    ),
}

for path in root.rglob("*"):
    if ".git" in path.parts or not path.is_file():
        continue
    try:
        content = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    for label, pattern in patterns.items():
        if pattern.search(content):
            raise SystemExit(f"Potential {label} found in {path.relative_to(root)}")

print("Repository structure: OK")
print("YAML and JSON: OK")
print("Python syntax: OK")
print("Permissions boundary: OK")
print("Secret scan: OK")
PY

python3 -m unittest discover \
  -s "$root/tests" \
  -p 'test_*.py'

if command -v node >/dev/null; then
  node --check "$root/import/static/visual-preview.mjs"
  node --test "$root/tests/test_visual_preview.mjs"
else
  echo "JavaScript tests skipped: install Node.js to run them."
fi

for script in "$root"/scripts/* "$root"/export/*.sh "$root"/import/*.sh; do
  [[ -f "$script" ]] || continue
  bash -n "$script"
done

echo "Shell syntax: OK"
echo "All checks passed."
